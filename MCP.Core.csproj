<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RootNamespace>MCP.Core</RootNamespace>
    <AssemblyName>MCP.Core</AssemblyName>
    <Description>MCP tool server using HttpListener and Dignus dependency injection.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dignus" Version="1.4.3" />
  </ItemGroup>
</Project>
